---
import { Head } from "@/components/Head";
import AppRoot from "@/components/AppRoot";
import "@/styles/global.css";

// CSP is configured in astro.config.mjs to ensure a single, consistent policy
// that includes all required Wix infrastructure domains (Framewire, fonts, etc.)
// Do not set conflicting CSP headers here.

Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
// X-Frame-Options removed to allow Wix preview/framewire framing
// Astro.response.headers.set('X-Frame-Options', 'SAMEORIGIN');
Astro.response.headers.set('X-XSS-Protection', '1; mode=block');
---

<html lang="en" class="w-full h-full">
  <head>
    <!-- Preconnect to Google Fonts for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <Head />
    
    <!-- CRITICAL: Block FullStory at the earliest possible point, before any scripts load -->
    <script is:inline>
      // Block window.FS immediately
      if (typeof window !== 'undefined') {
        try {
          Object.defineProperty(window, 'FS', {
            get() { return undefined; },
            set(v) { /* ignore */ },
            configurable: false
          });
        } catch (e) {}
        
        try {
          Object.defineProperty(window, '_fs_ready', {
            get() { return undefined; },
            set(v) { /* ignore */ },
            configurable: false
          });
        } catch (e) {}
        
        // Block script loading before appendChild is called
        const origAppendChild = Element.prototype.appendChild;
        Element.prototype.appendChild = function(node) {
          if (node instanceof HTMLScriptElement) {
            const src = (node.src || node.getAttribute('src') || '').toLowerCase();
            if (src.includes('fullstory')) {
              return node; // Block it
            }
          }
          return origAppendChild.call(this, node);
        };
        
        const origInsertBefore = Element.prototype.insertBefore;
        Element.prototype.insertBefore = function(newNode, refNode) {
          if (newNode instanceof HTMLScriptElement) {
            const src = (newNode.src || newNode.getAttribute('src') || '').toLowerCase();
            if (src.includes('fullstory')) {
              return newNode; // Block it
            }
          }
          return origInsertBefore.call(this, newNode, refNode);
        };
      }
    </script>
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRoot client:only="react" />
    </div>
  </body>
</html>
